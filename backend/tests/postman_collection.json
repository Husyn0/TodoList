{
  "info": {
    "name": "TodoList API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "password123" },
    { "key": "task_id", "value": "" },
    { "key": "user_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);",
                  "if (json.user && json.user.id) pm.collectionVariables.set('user_id', json.user.id);",
                  "if (json.user && json.user.email) pm.collectionVariables.set('email', json.user.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test+{{$timestamp}}@example.com\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/register", "host": ["{{base_url}}"], "path": ["api","register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api","login"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/me", "host": ["{{base_url}}"], "path": ["api","me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/logout", "host": ["{{base_url}}"], "path": ["api","logout"] }
          }
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "Show",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/settings", "host": ["{{base_url}}"], "path": ["api","settings"] }
          }
        },
        {
          "name": "Update (with week_end)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Renamed\",\n  \"theme\": \"dark\",\n  \"timezone\": \"Asia/Beirut\",\n  \"week_start\": \"monday\",\n  \"week_end\": \"friday\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/settings", "host": ["{{base_url}}"], "path": ["api","settings"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{password}}\",\n  \"password\": \"newpass1234\",\n  \"password_confirmation\": \"newpass1234\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/settings/password", "host": ["{{base_url}}"], "path": ["api","settings","password"] }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create (with period)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('task_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Task A\",\n  \"description\": \"first\",\n  \"due_date\": \"2026-10-05\",\n  \"priority\": \"high\",\n  \"status\": \"pending\",\n  \"position\": 0,\n  \"period\": \"morning\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/tasks", "host": ["{{base_url}}"], "path": ["api","tasks"] }
          }
        },
        {
          "name": "List (week)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks?week_start=2026-10-05",
              "host": ["{{base_url}}"],
              "path": ["api","tasks"],
              "query": [{ "key": "week_start", "value": "2026-10-05" }]
            }
          }
        },
        {
          "name": "Range",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks/range?from=2026-10-01&to=2026-10-31",
              "host": ["{{base_url}}"],
              "path": ["api","tasks","range"],
              "query": [
                { "key": "from", "value": "2026-10-01" },
                { "key": "to", "value": "2026-10-31" }
              ]
            }
          }
        },
        {
          "name": "Update (with period)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Task A (updated)\",\n  \"status\": \"in_progress\",\n  \"priority\": \"medium\",\n  \"period\": \"afternoon\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/tasks/{{task_id}}", "host": ["{{base_url}}"], "path": ["api","tasks","{{task_id}}"] }
          }
        },
        {
          "name": "Move",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"due_date\": \"2026-10-08\",\n  \"position\": 5\n}"
            },
            "url": { "raw": "{{base_url}}/api/tasks/{{task_id}}/move", "host": ["{{base_url}}"], "path": ["api","tasks","{{task_id}}","move"] }
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/tasks/{{task_id}}", "host": ["{{base_url}}"], "path": ["api","tasks","{{task_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Tracks",
      "item": [
        {
          "name": "Upsert Track",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\",\n  \"meeting_time\": \"09:45\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/tracks/{{task_id}}/2026-10-07", "host": ["{{base_url}}"], "path": ["api","tracks","{{task_id}}","2026-10-07"] }
          }
        },
        {
          "name": "List Tracks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/tracks?from=2026-10-01&to=2026-10-31",
              "host": ["{{base_url}}"],
              "path": ["api","tracks"],
              "query": [
                { "key": "from", "value": "2026-10-01" },
                { "key": "to", "value": "2026-10-31" }
              ]
            }
          }
        },
        {
          "name": "Delete Track",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/tracks/{{task_id}}/2026-10-07", "host": ["{{base_url}}"], "path": ["api","tracks","{{task_id}}","2026-10-07"] }
          }
        },
        {
          "name": "Delete All Tracks For Task",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/tracks/task/{{task_id}}", "host": ["{{base_url}}"], "path": ["api","tracks","task","{{task_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Email & Password",
      "item": [
        {
          "name": "Verification Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/email/verification-status", "host": ["{{base_url}}"], "path": ["api","email","verification-status"] }
          }
        },
        {
          "name": "Resend Verification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/api/email/verification-notification", "host": ["{{base_url}}"], "path": ["api","email","verification-notification"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/forgot-password", "host": ["{{base_url}}"], "path": ["api","forgot-password"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"token\": \"PASTE_TOKEN\",\n  \"password\": \"newpass4321\",\n  \"password_confirmation\": \"newpass4321\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/reset-password", "host": ["{{base_url}}"], "path": ["api","reset-password"] }
          }
        }
      ]
    }
  ]
}